# Copy to .env and adjust. Used by docker-compose and ripplekg.config.
ARANGO_ROOT_PASSWORD=ripplekg-dev

# How the api service reaches ArangoDB (service name inside the compose network).
ARANGO_URL=http://arangodb:8529
ARANGO_DB=ripplekg
ARANGO_USER=root
ARANGO_PASSWORD=ripplekg-dev

# Optional LLM providers. Configure at least one for fact-based sentence edits
# and LLM relevance-gate evaluation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional semantic retrieval settings. "auto" uses sentence-transformers when
# installed and otherwise falls back to lightweight hashing vectors.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
LIGHTWEIGHT_EMBEDDING_DIMENSION=384
SIMILARITY_THRESHOLD=0.85

# Optional relation-schema matching.
SCHEMA_MERGE_THRESHOLD=0.82
SCHEMA_MERGE_USE_EMBEDDINGS=false
